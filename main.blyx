use std::cli;
use std::text;
use vendor::backup_chain::backup_chain;

fn main() {
    let arguments = cli_args();
    if args_len(arguments) > 0 {
        if args_len(arguments) % 2 != 0 {
            stderr_line("Expected event and value pairs");
            process_exit(2);
        }
        let mut live = backup_chain_start();
        let mut i = 0;
        while i < args_len(arguments) {
            let input = args_at(arguments, i + 1);
            if !text_is_number(input) {
                stderr_line("Expected a whole numeric event value");
                process_exit(2);
            }
            live = backup_chain_step(live, args_at(arguments, i), text_number(input));
            let command = backup_chain_command(live);
            println!(command);
            if command == "reject" { process_exit(1); }
            i += 2;
        }
        return;
    }
    let mut state = backup_chain_start();
    state = backup_chain_step(state, "base", 4.0);
    println!(backup_chain_command(state));
    state = backup_chain_step(state, "verified", 4.0);
    println!(backup_chain_command(state));
    state = backup_chain_step(state, "increment", 6.0);
    println!(backup_chain_command(state));
    state = backup_chain_step(state, "increment", 5.0);
    println!(backup_chain_command(state));
    state = backup_chain_step(state, "seal", 5.0);
    println!(backup_chain_command(state));
}
