// Require a base snapshot and contiguous increments before sealing a restorable backup chain.
use std::cli;

pub fn backup_chain_start() -> vector { [0, 0, 0] }

pub fn backup_chain_step(snapshot: vector, event: str, value: f64) -> vector {
    if len(snapshot) != 3 { return []; }
    let phase = at(snapshot, 0);
    let saved = at(snapshot, 1);
    let previous = at(snapshot, 2);
    if !(phase >= 0.0 && phase < 4.0 && phase % 1.0 == 0.0 && previous >= 0.0 && previous < 6.0 && previous % 1.0 == 0.0 && saved >= 0.0 && saved <= 9007199254740991.0 && saved % 1.0 == 0.0) { return []; }
    if !(value >= 0.0 && value <= 1000000000.0 && value % 1.0 == 0.0) { return [phase, saved, 0]; }
    // idle
    if phase == 0.0 {
        if event == "base" {
            return [1, value, 1]; // copy_base
        }
    }
    // copying
    if phase == 1.0 {
        if event == "verified" && value==saved {
            return [2, saved, 2]; // accept_increment
        }
    }
    // open
    if phase == 2.0 {
        if event == "increment" && value==saved+1.0 {
            return [2, value, 3]; // record_increment
        }
        if event == "seal" && value==saved {
            return [3, saved, 4]; // publish_manifest
        }
        if event == "gap" && value>saved+1.0 {
            return [1, value, 5]; // restart_from_base
        }
    }
    [phase, saved, 0]
}

pub fn backup_chain_command(snapshot: vector) -> str {
    if len(snapshot) != 3 { return "invalid"; }
    let action = at(snapshot, 2);
    if action == 0.0 { return "reject"; }
    if action == 1.0 { return "copy_base"; }
    if action == 2.0 { return "accept_increment"; }
    if action == 3.0 { return "record_increment"; }
    if action == 4.0 { return "publish_manifest"; }
    if action == 5.0 { return "restart_from_base"; }
    "invalid"
}

// Stop at the first rejected event. No host effects run during replay.
pub fn backup_chain_replay(events: arglist, values: vector) -> vector {
    if args_len(events) != len(values) { return []; }
    let mut state = backup_chain_start();
    let mut i = 0;
    while i < len(values) {
        state = backup_chain_step(state, args_at(events, i), at(values, i));
        if at(state, 2) == 0.0 { return []; }
        i += 1;
    }
    state
}
